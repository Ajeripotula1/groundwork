# Python
__pycache__/
*.py[cod]
*.egg-info/
*.egg
build/
dist/

# Virtual environment
.venv/
venv/

# Test/lint/type-checker caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Secrets — real values live in .env, never committed. .env.example is the template.
.env

# Editors/IDEs
.vscode/
.idea/

# OS
.DS_Store

# Frontend (Slice 8) — no frontend/ exists yet, but node_modules is never
# something to commit once it does.
node_modules/

# Logs
*.log

# agentcore configure/deploy generates these per-machine (account id, image
# tags, local source paths) - never something to commit, same reasoning as
# .env above.
.bedrock_agentcore.yaml
.bedrock_agentcore/
.dockerignore
