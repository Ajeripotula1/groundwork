# Copy this file to `.env` and adjust for your machine:
#   cp .env.example .env
# .env is gitignored — never commit real secrets into it.

# Matches docker-compose.yml's local Postgres. In AWS this becomes the
# Supabase connection string, injected via SSM Parameter Store instead of
# a file — application code never needs to know which one it's reading from.
#
# The "+psycopg" is required, not cosmetic: this project depends on psycopg3
# ("psycopg[binary]" in pyproject.toml), but SQLAlchemy's default dialect for
# a bare "postgresql://" URL is still psycopg2. Without "+psycopg" here,
# every DB call fails with `ModuleNotFoundError: No module named 'psycopg2'`
# even with Postgres running and reachable.
DATABASE_URL=postgresql+psycopg://groundwork:groundwork@localhost:5432/groundwork

# local | production — lets code branch on environment without checking
# AWS-specific env vars directly.
ENVIRONMENT=local

# debug | info | warning | error
LOG_LEVEL=info

# Region the Bedrock Runtime client targets - must match where model access
# was granted in the AWS console.
AWS_REGION=us-east-1

# Bedrock inference-profile ID used by the resume-extraction utility.
BEDROCK_EXTRACTION_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
